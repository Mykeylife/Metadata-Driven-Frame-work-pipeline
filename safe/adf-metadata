import subprocess
import sys
import re

def run_sql(query):
    cmd = [
        'sqlcmd', '-S', 'localhost', '-U', 'SA', '-P', 'YourStrong!Passw0rd', '-Q', query, '-W', '-s',',',
    ]
    out = subprocess.check_output(cmd, universal_newlines=True)
    return out


def test_transformdefinitions_exists():
    out = run_sql("SET NOCOUNT ON; SELECT COUNT(*) FROM dbo.TransformDefinitions")
    # sqlcmd outputs headers; find the number
    m = re.search(r"(\d+)", out)
    assert m, f"Unexpected output: {out}"
    count = int(m.group(1))
    assert count >= 1, "No TransformDefinitions found"


def test_stored_proc_runs_and_audited():
    # Call the sample stored procedure
    run_sql("EXEC dbo.usp_TransformA @srcPath='src', @sinkPath='sink', @pipelineId='test'")
    out = run_sql("SELECT COUNT(*) FROM dbo.TransformAudit WHERE PipelineId='test'")
    m = re.search(r"(\d+)", out)
    assert m, f"Unexpected output: {out}"
    count = int(m.group(1))
    assert count >= 1, "Stored procedure did not write audit row"
